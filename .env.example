# Haggle environment variables — copy to .env.local and fill in.
# See PDR.md Appendix A. NEVER commit real secrets.

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-flash-lite-latest  # 3.8-flash 503s under load; lite has its own quota
GEMINI_MODEL_SMART=gemini-flash-lite-latest
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-flash-latest

# --- Nessie (Capital One mock banking) ---
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com  # verified 2026-10-03 (https, not http)

# --- SpaceXAI / Grok Voice (TTS for the simulated call) ---
XAI_API_KEY=
XAI_VOICE_AGENT=eve
XAI_VOICE_REP=ara

# --- ElevenLabs (voice agent + telephony) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=                  # ID of the imported Twilio number
ELEVENLABS_WEBHOOK_SECRET=                   # HMAC for post-call webhooks
TOOL_SHARED_SECRET=                          # header value ElevenLabs sends to /api/tools/*

# --- Neon Postgres ---
DATABASE_URL=

# --- App ---
APP_BASE_URL=http://localhost:3000           # public URL (Vercel or tunnel) for webhooks/tools
CALL_ALLOWLIST=                              # comma-separated E.164 numbers; the rep teammate's phone
DEMO_USER_ID=

# The Twilio account credentials are needed ONLY in the ElevenLabs dashboard
# during the one-time number import. They never go into this app.
